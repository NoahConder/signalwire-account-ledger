# Copy to .env and fill in. .env is gitignored and passed into the dev container.

# Your space: "example" or "example.signalwire.com" for https://example.signalwire.com
SIGNALWIRE_SPACE=

# Project ID + API token (Basic auth project_id:token).
# Used by the voice, messaging, fax, video and conference log endpoints.
# The token needs the Voice, Messaging, Fax and Video scopes.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# Personal access token, sent as Basic auth with an empty username.
# Used by everything under /api/space: balance, usage, statements, payment history and the
# billing profile. The holder must be an owner or admin of the space.
# Project API tokens are rejected on these endpoints.
SIGNALWIRE_PAT=
